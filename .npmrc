# pnpm: fail if a package has unlisted peer dependencies
strict-peer-dependencies=false

# Hoist common deps to the root node_modules for tooling compatibility
shamefully-hoist=false

# Prefer workspace protocol
link-workspace-packages=true
prefer-workspace-packages=true

# Keep the lockfile deterministic across machines
resolution-mode=highest

# Store location (overridable via PNPM_STORE_DIR)
store-dir=.pnpm-store
