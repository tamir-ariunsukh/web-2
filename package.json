{
  "name": "airline-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Flight booking platform: plain Node.js backend and frontend, no runtime dependencies",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/db/seed.js",
    "db:reset": "node --env-file-if-exists=.env server/db/migrate.js --reset",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test \"test/**/*.test.js\""
  }
}
